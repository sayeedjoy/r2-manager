# --- Database ---
# Postgres connection string (Neon/Supabase pooler on Vercel, direct URL on Dokploy)
DATABASE_URL=

# --- R2 / S3 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Comma-separated list of bucket names this deployment is allowed to manage
R2_BUCKETS=
# Optional: override the S3 endpoint (defaults to https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# --- Authentication (AUTH-03) ---
# "password": the app's own email + password sign-in, with optional 2FA (TOTP).
# "access":   Cloudflare Access only.
# "both":     Cloudflare Access in front AND a password session for the same email.
# On first run the app asks you to register the admin account in the browser.
AUTH_MODE=password

# Cloudflare Access (AUTH-01), required when AUTH_MODE is "access" or "both"
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# 32+ random bytes (e.g. `openssl rand -hex 32`). Signs cookies and encrypts 2FA secrets and the
# SMTP password stored in the database. Changing it later wipes out saved 2FA and SMTP secrets.
SESSION_SECRET=

# Optional: if set, first-run admin registration also asks for this value (16+ characters), so
# nobody who stumbles on a fresh deployment can claim the admin account first.
SETUP_TOKEN=

# Outgoing email (password reset, invites) is configured in the app under Admin > Email delivery,
# not here.

# --- Internal cron trigger (jobs/*) ---
CRON_SECRET=

# --- Demo website only ---
# "true" serves built-in sample files read-only, behind a shared demo account whose password is
# shown on the sign-in page, with no registration and no database (migrations are skipped). It
# overrides the database, R2 and auth settings above, so only APP_BASE_URL is needed. See
# docs/demo-mode.md.
# Never set it on a deployment that manages real files.
DEMO_MODE=false

# --- Misc ---
NODE_ENV=development
PORT=8787
# Public base URL of this deployment, used for share links
APP_BASE_URL=http://localhost:8787
# Number of reverse-proxy hops that append or replace X-Forwarded-For.
TRUST_PROXY_HOPS=1
