# --- Database ---
# Postgres connection string (Neon/Supabase pooler on Vercel, direct URL on Dokploy)
DATABASE_URL=postgres://user:password@localhost:5432/r2_manager

# --- R2 / S3 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Comma-separated list of bucket names this deployment is allowed to manage
R2_BUCKETS=my-bucket
# Optional: override the S3 endpoint (defaults to https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# --- Authentication (AUTH-03: at least one must be configured) ---
# "access", "basic", or "both"
AUTH_MODE=basic

# Cloudflare Access (AUTH-01)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Basic Authentication (AUTH-02) - scrypt hash ("scrypt:<salt>:<hash>"); generate with
# `pnpm --filter server run hash-password '<password>'`. Other formats (e.g. bcrypt) never match.
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD_HASH=

# Session/cookie signing secret (32+ random bytes, base64 or hex)
SESSION_SECRET=

# --- Email ingestion (MAIL-*) ---
MAIL_WEBHOOK_SECRET=

# --- Internal cron trigger (jobs/*) ---
CRON_SECRET=

# --- Misc ---
NODE_ENV=development
PORT=8787
# Public base URL of this deployment, used for share links
APP_BASE_URL=http://localhost:8787
# Number of reverse-proxy hops that append or replace X-Forwarded-For.
TRUST_PROXY_HOPS=1
