{
  "name": "r2-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter frontend --filter server dev",
    "dev:server": "pnpm --filter server dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter shared build && pnpm --filter frontend build && pnpm --filter server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter server test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
