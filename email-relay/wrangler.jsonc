{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-manager-email-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "r2_buckets": [
    { "binding": "INBOX_BUCKET", "bucket_name": "my-bucket" }
  ],
  "send_email": [],
  "vars": {
    "APP_WEBHOOK_URL": "https://your-app.example.com/api/v1/internal/mail-webhook",
    "RAW_MESSAGE_PREFIX": "_inbox/raw/",
    "INBOX_BUCKET_NAME": "my-bucket"
  }
}
